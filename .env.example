# GatherEase AI Quote Agent — 環境變數範本
# Copy 這個檔到 .env 並填入真實值。.env 已在 .gitignore，不會進 git。

# ─── NVIDIA Nemotron (cloud NIM API) ───
# 申請：https://build.nvidia.com → 右上角 API Keys → Generate
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── LINE Messaging API ───
# 來源：https://developers.line.biz/console/ → 你的 Channel → Messaging API 頁籤
# Channel Access Token：頁面最下方「Issue」一個 long-lived token
# Channel Secret：Basic settings 頁籤
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# Webhook URL（公開 HTTPS，三選一：Cloudflare Tunnel / ngrok / Nginx+LE）
LINE_WEBHOOK_URL=https://your-domain.example.com/webhook/line

# ─── Gmail (對外發信 + 收信) ───
# 發信：Google 帳號 → 安全性 → 兩步驟驗證 → App Passwords 產生 16 字元密碼
# 重要：務必用「專門測試 Gmail 帳號」，不要用主帳號
GMAIL_USER=gatherease-bot@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# 收信（可與發信同帳號或分開；建議同一個測試帳號就好）
GMAIL_IMAP_USER=gatherease-bot@gmail.com
GMAIL_IMAP_PASSWORD=xxxxxxxxxxxxxxxx

# ─── 系統 ───
NODE_ENV=development
LOG_LEVEL=info
AUDIT_LOG_PATH=./logs/audit.jsonl

# ─── Mac → Linux VM (跑真 NemoClaw) ───
# Tailscale hostname or IP for the Linux VM running OpenClaw + NemoClaw
# 例：100.x.y.z (Tailscale IP) 或 ubuntu-vm-nemo (Tailscale magic DNS)
NEMOCLAW_VM_HOST=
NEMOCLAW_VM_USER=ubuntu
NEMOCLAW_VM_OPENCLAW_GATEWAY_PORT=18789
